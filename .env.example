# Copy this file to .env for local development. Never commit .env.

# PostgreSQL connection string.
# Local example:   postgresql://postgres:postgres@localhost:5432/snack_attack
# Railway: set DATABASE_URL on the app service to ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snack_attack

# The organizer PIN (digits work best on phones; use 6 or more).
# Needed to check off shopping items, remove requests, manage staff, and reset.
ORGANIZER_PIN=123456

# Optional extra secret mixed into organizer sign-in cookies. Any long random string.
SESSION_SECRET=

# Only set to "true" if you connect over Railway's PUBLIC database URL and it requires SSL.
DATABASE_SSL=
